import argparse
import os
import sys

sys.path = [p for p in sys.path if p not in ("", ".")]
sys.path.insert(0, "/usr/lib/mythicos-update")


def main():
    if os.getuid() == 0:
        print("Error: do not run the Update Manager as root", file=sys.stderr)
        return 1
    parser = argparse.ArgumentParser(prog="mythicos-update", description="The MythicOS Update Manager")
    from mythicosupdate import __version__
    parser.add_argument("-v", "--version", action="version", version=__version__,
                        help="Display the current version")
    parser.parse_args()
    from mythicosupdate.ui.app import main as run
    return run()


if __name__ == "__main__":
    sys.exit(main())
