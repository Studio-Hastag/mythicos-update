import os
import sys

sys.path = [p for p in sys.path if p not in ("", ".")]
sys.path.insert(0, "/usr/lib/mythicos-update")

if os.getuid() == 0:
    print("Error: do not run the tray icon as root", file=sys.stderr)
    sys.exit(1)

from mythicosupdate.tray import main  # noqa: E402

sys.exit(main())
