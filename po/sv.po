#: src/mythicosupdate/desktop_strings.py:9 src/mythicosupdate/tray.py:42
#: src/mythicosupdate/ui/app.py:21 src/mythicosupdate/ui/window.py:33
#: src/mythicosupdate/ui/window.py:193
msgid "Update Manager"
msgstr "Uppdateringshanterare"

#: src/mythicosupdate/desktop_strings.py:10
msgid "Show and install available updates"
msgstr "Visa och installera tillgängliga uppdateringar"

#: src/mythicosupdate/desktop_strings.py:11
#: src/mythicosupdate/ui/window.py:413
msgid "Authentication is required to install updates"
msgstr "Autentisering krävs för att installera uppdateringar"

#: src/mythicosupdate/desktop_strings.py:12
msgid "Authentication is required to change the automatic updates setting"
msgstr ""
"Autentisering krävs för att ändra inställningen för automatiska "
"uppdateringar"

#: src/mythicosupdate/tray.py:43 src/mythicosupdate/ui/window.py:62
msgid "Refresh"
msgstr "Hämta om"

#: src/mythicosupdate/tray.py:44
msgid "Quit"
msgstr "Avsluta"

#: src/mythicosupdate/tray.py:66 src/mythicosupdate/ui/window.py:110
msgid "Checking for updates"
msgstr "Söker efter uppdateringar"

#: src/mythicosupdate/tray.py:67 src/mythicosupdate/ui/window.py:153
msgid "Your system is up to date"
msgstr "Ditt system är uppdaterat"

#: src/mythicosupdate/tray.py:68 src/mythicosupdate/ui/window.py:119
msgid "Updates are available"
msgstr "Nya uppdateringar finns"

#: src/mythicosupdate/tray.py:69 src/mythicosupdate/ui/window.py:138
#: src/mythicosupdate/ui/window.py:418 src/mythicosupdate/ui/window.py:460
msgid "Installing updates"
msgstr "Installerar uppdateringar"

#: src/mythicosupdate/tray.py:70 src/mythicosupdate/ui/window.py:245
#: src/mythicosupdate/ui/window.py:249
msgid "Could not refresh the list of updates"
msgstr "Kunde inte uppdatera listan med uppdateringar"

#: src/mythicosupdate/ui/details.py:39 src/mythicosupdate/ui/window.py:117
#: src/mythicosupdate/ui/window.py:172
msgid "Details"
msgstr "Detaljer"

#: src/mythicosupdate/ui/details.py:51
msgid "Security updates"
msgstr "Säkerhetsuppdateringar"

#: src/mythicosupdate/ui/details.py:51
msgid "Kernel updates"
msgstr "Kärnuppdateringar"

#: src/mythicosupdate/ui/details.py:52
#: src/mythicosupdate/ui/history_window.py:44
#: src/mythicosupdate/ui/history_window.py:45
msgid "Software updates"
msgstr "Programuppdateringar"

#: src/mythicosupdate/ui/details.py:61
msgid "New packages"
msgstr "Nya paket"

#: src/mythicosupdate/ui/details.py:65
msgid "Packages to remove"
msgstr "Paket att ta bort"

#: src/mythicosupdate/ui/details.py:69
msgid "Packages kept back"
msgstr "Tillbakahållna paket"

#: src/mythicosupdate/ui/details.py:70
msgid "Marked as held (apt-mark hold)"
msgstr "Markerad som spärrad (apt-mark hold)"

#: src/mythicosupdate/ui/details.py:71
msgid "Phased update, rolled out gradually"
msgstr "Stegvis uppdatering, släpps gradvis"

#: src/mythicosupdate/ui/details.py:72
msgid "Kept back by APT"
msgstr "Tillbakahållen av APT"

#: src/mythicosupdate/ui/details.py:78 src/mythicosupdate/ui/window.py:252
msgid "Broken packages"
msgstr "Trasiga paket"

#: src/mythicosupdate/ui/details.py:79
msgid "APT could not find a consistent set of changes"
msgstr "APT kunde inte hitta en konsekvent uppsättning ändringar"

#: src/mythicosupdate/ui/details.py:81
#: src/mythicosupdate/ui/history_window.py:44
#: src/mythicosupdate/ui/window.py:461
msgid "Flatpak updates"
msgstr "Uppdateringar av Flatpak"

#: src/mythicosupdate/ui/history_window.py:20
#: src/mythicosupdate/ui/window.py:63
msgid "History of Updates"
msgstr "Uppdateringshistorik"

#: src/mythicosupdate/ui/history_window.py:31
msgid "No updates have been installed yet"
msgstr "Inga uppdateringar har installerats ännu"

#: src/mythicosupdate/ui/history_window.py:45
msgid "Automatic updates"
msgstr "Automatiska uppdateringar"

#: src/mythicosupdate/ui/history_window.py:53
msgid "Failed"
msgstr "Misslyckades"

#: src/mythicosupdate/ui/preferences.py:25 src/mythicosupdate/ui/window.py:64
msgid "Preferences"
msgstr "Inställningar"

#: src/mythicosupdate/ui/preferences.py:30
msgid "Automation"
msgstr "Automatisering"

#: src/mythicosupdate/ui/preferences.py:32
msgid "Apply updates automatically"
msgstr "Installera uppdateringar automatiskt"

#: src/mythicosupdate/ui/preferences.py:33
msgid "Performed as root on a daily basis"
msgstr "Genomförs en gång per dag med administratörsbehörighet"

#: src/mythicosupdate/ui/preferences.py:38
msgid "Auto-refresh"
msgstr "Uppdatera automatiskt"

#: src/mythicosupdate/ui/preferences.py:40
msgid "First, refresh the list of updates after:"
msgstr "Först, uppdatera listan med uppdateringar efter:"

#: src/mythicosupdate/ui/preferences.py:42
msgid "Then, refresh the list of updates every:"
msgstr "Sedan, uppdatera listan med uppdateringar varje:"

#: src/mythicosupdate/ui/preferences.py:50
msgid "minutes"
msgstr "minuter"

#: src/mythicosupdate/ui/preferences.py:80
msgid "Could not change the automatic updates setting."
msgstr "Det gick inte att ändra inställningen för automatiska uppdateringar."

#: src/mythicosupdate/ui/window.py:65
msgid "About"
msgstr "Om"

#: src/mythicosupdate/ui/window.py:115
msgid "Install"
msgstr "Installera"

#. up to date
#. new MythicOS version
#: src/mythicosupdate/ui/window.py:116 src/mythicosupdate/ui/window.py:149
#: src/mythicosupdate/ui/window.py:158
msgid "Settings"
msgstr "Inställningar"

#: src/mythicosupdate/ui/window.py:120 src/mythicosupdate/ui/window.py:280
msgid "Updates are available. Do you want to install them?"
msgstr "Uppdateringar finns tillgängliga. Vill du installera dem?"

#: src/mythicosupdate/ui/window.py:121 src/mythicosupdate/ui/window.py:146
#: src/mythicosupdate/ui/window.py:163
msgid "Later"
msgstr "Senare"

#: src/mythicosupdate/ui/window.py:132
msgid "Terminal"
msgstr "Terminal"

#: src/mythicosupdate/ui/window.py:143
msgid "Restart required"
msgstr "Omstart krävs"

#: src/mythicosupdate/ui/window.py:144
msgid "A restart is needed to finish applying the updates."
msgstr "En omstart krävs för att slutföra tillämpningen av uppdateringarna."

#: src/mythicosupdate/ui/window.py:145
msgid "Restart"
msgstr "Starta om"

#: src/mythicosupdate/ui/window.py:154 src/mythicosupdate/ui/window.py:176
#: src/mythicosupdate/ui/window.py:184
msgid "Close"
msgstr "Stäng"

#: src/mythicosupdate/ui/window.py:160
msgid "A new version of MythicOS is available"
msgstr "En ny version av MythicOS är tillgänglig"

#: src/mythicosupdate/ui/window.py:161 src/mythicosupdate/ui/window.py:303
msgid ""
"Your software is up to date, but a new version of MythicOS is available. Do "
"you want to install it?"
msgstr ""
"Din programvara är uppdaterad, men en ny version av MythicOS är tillgänglig."
" Vill du installera den?"

#: src/mythicosupdate/ui/window.py:164
msgid "Upgrade"
msgstr "Uppgradera"

#: src/mythicosupdate/ui/window.py:174
msgid "Retry"
msgstr "Försök igen"

#: src/mythicosupdate/ui/window.py:181 src/mythicosupdate/ui/window.py:257
msgid "A previous installation was interrupted"
msgstr "En tidigare installation avbröts"

#: src/mythicosupdate/ui/window.py:182
msgid "The package system must be repaired before anything new is installed."
msgstr "Paketsystemet måste repareras innan något nytt installeras."

#: src/mythicosupdate/ui/window.py:183
msgid "Repair"
msgstr "Reparera"

#: src/mythicosupdate/ui/window.py:202
msgid "Please wait until the installation has finished."
msgstr "Vänta tills installationen har slutförts."

#: src/mythicosupdate/ui/window.py:240 src/mythicosupdate/ui/window.py:372
#: src/mythicosupdate/ui/window.py:516 src/mythicosupdate/ui/window.py:562
msgid "Cannot Proceed"
msgstr "Kan inte fortsätta"

#: src/mythicosupdate/ui/window.py:241 src/mythicosupdate/ui/window.py:373
#: src/mythicosupdate/ui/window.py:517 src/mythicosupdate/ui/window.py:563
msgid ""
"Another process is currently using the package management system. Please "
"wait for it to finish and then try again."
msgstr ""
"En annan process använder för närvarande pakethanteringssystemet. Var god "
"och vänta tills processen har avslutats och försök därefter igen."

#: src/mythicosupdate/ui/window.py:246
msgid "Check your Internet connection and try again."
msgstr "Kontrollera din internetanslutning och försök igen."

#: src/mythicosupdate/ui/window.py:253
msgid "APT could not find a consistent set of changes. Nothing was installed."
msgstr ""
"APT kunde inte hitta en konsekvent uppsättning ändringar. Inget "
"installerades."

#: src/mythicosupdate/ui/window.py:266
msgid "Could not check for Flatpak updates"
msgstr "Det gick inte att söka efter Flatpak-uppdateringar"

#: src/mythicosupdate/ui/window.py:277
msgid "A new version of the Update Manager is available"
msgstr "En ny version av Uppdateringshanteraren finns att hämta"

#: src/mythicosupdate/ui/window.py:278
msgid "It will be installed first, then the other updates."
msgstr "Den installeras först, därefter de övriga uppdateringarna."

#: src/mythicosupdate/ui/window.py:281
msgid "Updates to install: %d"
msgstr "Uppdateringar att installera: %d"

#: src/mythicosupdate/ui/window.py:284
msgid "Download size: %s"
msgstr "Nedladdningsstorlek: %s"

#: src/mythicosupdate/ui/window.py:286
msgid "Packages to remove: %d"
msgstr "Paket att ta bort: %d"

#: src/mythicosupdate/ui/window.py:288
msgid "Packages kept back: %d"
msgstr "Tillbakahållna paket: %d"

#: src/mythicosupdate/ui/window.py:292 src/mythicosupdate/ui/window.py:316
msgid "Software Sources is not installed."
msgstr "Programvarukällor är inte installerat."

#: src/mythicosupdate/ui/window.py:294
msgid "Error checking for flatpak updates: %s"
msgstr "Fel vid sökning efter Flatpak-uppdateringar: %s"

#: src/mythicosupdate/ui/window.py:313
msgid "Could not read %s"
msgstr "Det gick inte att läsa %s"

#: src/mythicosupdate/ui/window.py:333
msgid "Could not start Software Sources."
msgstr "Det gick inte att starta Programvarukällor."

#: src/mythicosupdate/ui/window.py:346
msgid "The program %s is not installed."
msgstr "Programmet %s är inte installerat."

#: src/mythicosupdate/ui/window.py:352
msgid "Could not start the upgrade."
msgstr "Det gick inte att starta uppgraderingen."

#: src/mythicosupdate/ui/window.py:379 src/mythicosupdate/ui/window.py:521
msgid "Not enough free disk space"
msgstr "Inte tillräckligt med ledigt diskutrymme"

#: src/mythicosupdate/ui/window.py:380 src/mythicosupdate/ui/window.py:522
msgid "%s more free space is needed to install the updates."
msgstr "%s mer ledigt utrymme behövs för att installera uppdateringarna."

#: src/mythicosupdate/ui/window.py:388
msgid "OK"
msgstr "OK"

#: src/mythicosupdate/ui/window.py:459
msgid "Repairing the package system"
msgstr "Reparerar paketsystemet"

#: src/mythicosupdate/ui/window.py:511
msgid "Authentication failed"
msgstr "Autentiseringen misslyckades"

#: src/mythicosupdate/ui/window.py:512
msgid "You are not allowed to install updates, or the password was refused."
msgstr ""
"Du har inte behörighet att installera uppdateringar, eller så nekades "
"lösenordet."

#: src/mythicosupdate/ui/window.py:525
msgid "The list of updates has changed"
msgstr "Uppdateringslistan har ändrats"

#: src/mythicosupdate/ui/window.py:526
msgid ""
"The changes APT would make differ from what was shown. Nothing was "
"installed."
msgstr ""
"Ändringarna som APT skulle göra skiljer sig från det som visades. Inget "
"installerades."

#: src/mythicosupdate/ui/window.py:529
msgid "Could not repair the package system"
msgstr "Det gick inte att reparera paketsystemet"

#: src/mythicosupdate/ui/window.py:530
msgid "Run 'apt update' in a terminal window to address this"
msgstr "Kör 'apt update' i ett terminalfönster för att korrigera detta"

#. The APT step already succeeded: say so separately.
#: src/mythicosupdate/ui/window.py:533
msgid "Could not update the Flatpaks"
msgstr "Det gick inte att uppdatera Flatpak-paketen"

#: src/mythicosupdate/ui/window.py:534
msgid "The system updates were installed, but the Flatpak updates failed."
msgstr ""
"Systemuppdateringarna installerades, men Flatpak-uppdateringarna "
"misslyckades."

#: src/mythicosupdate/ui/window.py:537
msgid "Could not install the updates"
msgstr "Det gick inte att installera uppdateringarna"
